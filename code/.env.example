# ===========================================================================
# Example environment file for MSI-Bench.
#
#   cp .env.example .env      # then fill in your real keys
#
# These variables are ONLY needed for LLM-based
# synthetic data generation (benchmark construction) and the LLM-as-judge
# baseline (E7). Experiment E0 and the real-data pipeline need NONE of them.
#
# The framework loads `.env` automatically (a tiny built-in parser; no
# python-dotenv dependency required).
# ===========================================================================

# --- Anthropic (used by generator family A and/or judge family C) ----------
ANTHROPIC_API_KEY=REPLACE_ME

# --- OpenAI / OpenAI-compatible endpoint (generator family B, OSS models) ---
OPENAI_API_KEY=REPLACE_ME
# Optional: point at a self-hosted / OpenAI-compatible server for open-weights
# models (vLLM, TGI, Together, Fireworks, etc.). Leave unset for api.openai.com.
# OPENAI_BASE_URL=https://your-endpoint.example.com/v1

# --- Google Gemini (any family configured with provider: gemini) -----------
GEMINI_API_KEY=REPLACE_ME

# --- Gateway token (provider: anthropic_proxy / openai_responses) ----------
# A single token can authenticate BOTH gateway endpoints: the
# Anthropic-compatible `/messages` endpoint and the OpenAI-compatible
# `/responses` endpoint. Name this variable in `api_key_env` of the
# corresponding block of `config.yaml`; leave unset for public providers.
# The gateway address is `base_url:` of that block or, if absent, LLM_BASE_URL.
# LLM_BASE_URL=https://gateway.example.org/api/external
LLM_GATEWAY_API_TOKEN=REPLACE_ME
